# EditorConfig helps maintain consistent coding styles
# for multiple developers working on the same project

root = true

# All files
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# JavaScript, CSS, HTML
[*.{js,css,html,json}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
